# ERC-8426 Pet Pass example: every variable the app reads.
# Local mode: `pnpm chain` writes the first block to .env.local for you.
# Copy this file to .env.local only for testnet or real wallet mode.
# Never commit .env.local: it holds the operator key.

# Chain and contract (required)
# JSON-RPC URL the server uses. The browser never sees it; it talks to /api/rpc.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# A PetPass deployment whose passBaseURI is NEXT_PUBLIC_BASE_URL + "/wallet-pass/".
CONTRACT_ADDRESS=
# Block the contract was deployed at, so "My passes" scans logs from there.
DEPLOY_BLOCK=0
# 32-byte hex key of the operator: the PetPass owner (it mints) and its
# BoundedAction operator (it relays feed, water and play). Generate one with
# `cast wallet new` or viem's generatePrivateKey; fund it with gas money.
OPERATOR_PRIVATE_KEY=

# The public origin of this app. The SIWE domain of every challenge is its
# host, and clients refuse to sign a challenge for any other domain, so this
# must be the address people actually open.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Dev wallet: an in-browser burner plus a faucet. Only honoured when the chain
# id is 31337 (anvil). Leave unset anywhere else.
DEV_WALLET=1

# Set to "off" to disable the open /api/mint route on a public deployment.
# MINT_API=off

# Apple Wallet (optional; all five required to enable)
# PEM values: paste the PEM with \n for newlines, or base64 of the whole PEM.
# See packages/apple/README.md for how to get each one.
# APPLE_PASS_TYPE_ID=pass.com.example.petpass
# APPLE_TEAM_ID=ABCDE12345
# APPLE_SIGNER_CERT=
# APPLE_SIGNER_KEY=
# APPLE_SIGNER_KEY_PASSPHRASE=
# APPLE_WWDR=
# Push updates through APNs with the pass certificate. Apple only calls the
# PassKit web service over public https, so this matters once deployed.
# APPLE_APNS=1

# Google Wallet (optional; both required to enable)
# The numeric issuer id from the Google Pay and Wallet Console, and the
# service account key JSON (raw JSON or base64). See packages/google/README.md.
# GOOGLE_ISSUER_ID=3388000000000000000
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_CLASS_SUFFIX=erc8426_petpass_example

# scripts/chain.mjs overrides (local mode only)
# ANVIL_BIN=/path/to/anvil
# ANVIL_PORT=8545
# LAPSE_SECONDS=259200
