{
  "name": "@erc8426/react",
  "version": "0.2.0",
  "description": "React hooks and an Add to Wallet button for ERC-8426 wallet passes",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huntclubhero/erc8426-sdk.git",
    "directory": "packages/react"
  },
  "keywords": [
    "erc-8426",
    "wallet-pass",
    "apple-wallet",
    "google-wallet",
    "nft",
    "erc-721"
  ],
  "publishConfig": {
