  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@erc8426/core": "workspace:^",
    "@erc8426/client": "workspace:^"
  },
  "peerDependencies": {
    "viem": "^2.21.0",
    "react": ">=18"
  }
}
