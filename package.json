{
  "name": "erc8426-sdk",
  "private": true,
  "description": "SDK for ERC-8426, the Wallet Pass Extension for NFTs",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:contracts": "cd packages/contracts && forge test"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.0",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "express": "^4.22.3",
    "jsdom": "^30.1.1",
    "node-forge": "^1.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "viem": "^2.37.0",
    "vitest": "^4.1.10"
  }
}
